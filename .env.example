# Required for answers. Create a key at https://platform.openai.com/api-keys
# The AI SDK reads this variable. Do not commit the real value, and do not
# expose it to the browser.
OPENAI_API_KEY=

# Optional. An OpenAI model ID. Default: gpt-6-luna
# https://developers.openai.com/api/docs/models
OPENAI_MODEL=gpt-6-luna

# Optional. Free questions per browser per UTC day. Default: 10
DAILY_QUESTION_LIMIT=10

# Optional. Shown as "Support this ministry" on the website only.
# The iOS app does not open this link. It uses Apple In-App Purchase instead.
NEXT_PUBLIC_SUPPORT_URL=

# Optional. Absolute site URL for link previews. When unset, Vercel uses
# VERCEL_PROJECT_PRODUCTION_URL, then https://ask-jesus-lake.vercel.app.
NEXT_PUBLIC_SITE_URL=

# iOS purchases. These are server-only. The In-App Purchase key can be a
# different key from the GitHub Actions App Store Connect API key.
# Leave them unset on the website and the free daily limit still works.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# Optional. Defaults to com.starseedsquad.askjesus.
APPLE_BUNDLE_ID=
# Required before production purchases can be confirmed. Numeric Apple ID of the app.
APPLE_APP_APPLE_ID=
# Optional. "true" turns on certificate revocation checks. The App Store Server API is still called either way.
APPLE_IAP_ONLINE_CHECKS=
# Required to remember a verified unlock. Use a long random string.
UNLOCK_COOKIE_SECRET=
