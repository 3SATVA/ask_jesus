# Required for local answers. Create a key in the Vercel AI Gateway dashboard.
# The AI SDK reads this variable itself. Do not commit the real value.
AI_GATEWAY_API_KEY=

# Optional. A provider/model ID from https://ai-gateway.vercel.sh/v1/models
# Default: google/gemini-3.8-flash
AI_GATEWAY_MODEL=google/gemini-3.8-flash

# Optional. Free questions per browser per UTC day. Default: 5
DAILY_QUESTION_LIMIT=5

# Optional. Shown as "Support this ministry". Use your giving or tip page.
NEXT_PUBLIC_SUPPORT_URL=

# Optional. Used for Open Graph absolute URLs. Vercel sets this in production
# from VERCEL_PROJECT_PRODUCTION_URL when this is unset.
NEXT_PUBLIC_SITE_URL=
