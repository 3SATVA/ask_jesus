# Required for answers. Create a key at https://platform.openai.com/api-keys
# The AI SDK reads this variable. Do not commit the real value, and do not
# expose it to the browser.
OPENAI_API_KEY=

# Optional. An OpenAI model ID. Default: gpt-6-luna
# https://developers.openai.com/api/docs/models
OPENAI_MODEL=gpt-6-luna

# Optional. Free questions per browser per UTC day. Default: 10
DAILY_QUESTION_LIMIT=10

# Optional. Shown as "Support this ministry". Use your giving or tip page.
NEXT_PUBLIC_SUPPORT_URL=

# Optional. Absolute site URL for link previews. When unset, Vercel uses
# VERCEL_PROJECT_PRODUCTION_URL, then https://ask-jesus-lake.vercel.app.
NEXT_PUBLIC_SITE_URL=
